#!/usr/bin/env bash

_HUATUO_CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export GPU_PROFILE="${GPU_PROFILE:-vgpu48}"

case "${GPU_PROFILE}" in
  vgpu48)
    export ACCELERATE_CONFIG="${_HUATUO_CONFIG_DIR}/deepspeed_zero3_vgpu48.yaml"
    export SFT_MAX_SEQ_LEN=4096
    export SFT_TRAIN_BSZ=1
    export SFT_GRAD_ACCUM=16
    export PPO_RESPONSE_LENGTH=1024
    export PPO_ROLLOUT_BATCH=1
    export EVAL_BATCH_SIZE=32
    ;;
  a80080)
    export ACCELERATE_CONFIG="${_HUATUO_CONFIG_DIR}/deepspeed_zero3_a800.yaml"
    export SFT_MAX_SEQ_LEN=8192
    export SFT_TRAIN_BSZ=2
    export SFT_GRAD_ACCUM=8
    export PPO_RESPONSE_LENGTH=1300
    export PPO_ROLLOUT_BATCH=4
    export EVAL_BATCH_SIZE=64
    ;;
  *)
    echo "不支持的 GPU_PROFILE=${GPU_PROFILE}，可选值为 vgpu48 或 a80080" >&2
    return 1
    ;;
esac

unset _HUATUO_CONFIG_DIR
