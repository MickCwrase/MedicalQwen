#!/usr/bin/env bash

# 项目和 Qwen3.5-0.8B 在服务器上保持同级目录。
_HUATUO_CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_HUATUO_PROJECT_DIR="$(cd "${_HUATUO_CONFIG_DIR}/.." && pwd)"
_HUATUO_WORK_ROOT="$(cd "${_HUATUO_PROJECT_DIR}/.." && pwd)"

export HUATUO_MODEL_PATH="${HUATUO_MODEL_PATH:-${_HUATUO_WORK_ROOT}/Qwen3.5-0.8B}"
export HUATUO_TOKENIZER_PATH="${HUATUO_TOKENIZER_PATH:-${HUATUO_MODEL_PATH}}"
export HUATUO_REWARD_MODEL_PATH="${HUATUO_REWARD_MODEL_PATH:-FreedomIntelligence/medical_o1_verifier_3B}"
# PPO's value backbone must share the Qwen3.5 vocabulary with the policy.
# Leave it empty so RL_stage2.py falls back to --model_name_or_path.
export HUATUO_VALUE_MODEL_PATH="${HUATUO_VALUE_MODEL_PATH:-}"

export HUATUO_TORCH_DTYPE="${HUATUO_TORCH_DTYPE:-bfloat16}"
export HUATUO_ATTN_IMPLEMENTATION="${HUATUO_ATTN_IMPLEMENTATION:-auto}"
export HUATUO_REWARD_ATTN_IMPLEMENTATION="${HUATUO_REWARD_ATTN_IMPLEMENTATION:-sdpa}"
export HUATUO_VALUE_ATTN_IMPLEMENTATION="${HUATUO_VALUE_ATTN_IMPLEMENTATION:-sdpa}"
export HUATUO_TRUST_REMOTE_CODE="${HUATUO_TRUST_REMOTE_CODE:-false}"
export HUATUO_FREEZE_VISION_ENCODER="${HUATUO_FREEZE_VISION_ENCODER:-true}"
export HUATUO_ENABLE_THINKING="${HUATUO_ENABLE_THINKING:-false}"
export WANDB_MODE="${WANDB_MODE:-offline}"

unset _HUATUO_CONFIG_DIR _HUATUO_PROJECT_DIR _HUATUO_WORK_ROOT
